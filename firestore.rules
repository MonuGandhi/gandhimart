rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMasterAdmin() {
      return request.auth != null && 
        request.auth.token != null && 
        request.auth.token.email != null && (
          request.auth.token.email.lower() == "monugandhi5911@gmail.com" || 
          request.auth.token.email.lower() == "monugandhi03@gmail.com"
        );
    }

    function isStaff() {
      return request.auth != null && 
        request.auth.token != null && 
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role in ['admin', 'pro_admin'];
    }

    function isStaffMember() {
       return request.auth != null && 
        request.auth.token != null && 
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role in ['admin', 'pro_admin', 'delivery_boy'];
    }

    function hasAdminAccess() {
      return isMasterAdmin() || isStaff();
    }

    function isOwner(userId) {
      return request.auth != null && 
        request.auth.token != null && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == userId;
    }

    // Products, Categories, Banners, Settings, Coupons
    match /products/{docId} {
      allow read: if true;
      allow create, delete: if hasAdminAccess();
      allow update: if hasAdminAccess() ||
        // Allow customers to update rating/reviewCount
        (request.auth != null &&
         request.auth.token != null &&
         request.auth.token.email != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']) &&
         request.resource.data.rating >= 1 &&
         request.resource.data.rating <= 5 &&
         (request.resource.data.reviewCount == resource.data.get('reviewCount', 0) + 1 ||
          request.resource.data.reviewCount == resource.data.get('reviewCount', 0) - 1 ||
          request.resource.data.reviewCount == resource.data.get('reviewCount', 0))) ||
        // Allow customers to update stock and/or inStock (for order placement)
        (request.auth != null &&
         request.auth.token != null &&
         request.auth.token.email != null &&
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inStock']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock'])));
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && 
                      request.auth.token != null && 
                      request.auth.token.email != null && 
                      request.resource.data.get('userEmail', '').lower() == request.auth.token.email.lower();
      allow update, delete: if hasAdminAccess() || 
        (request.auth != null && 
         request.auth.token != null && 
         request.auth.token.email != null && 
         resource.data.get('userEmail', '').lower() == request.auth.token.email.lower());
    }
    match /categories/{docId} { allow read: if true; allow write: if hasAdminAccess(); }
    match /banners/{docId} { allow read: if true; allow write: if hasAdminAccess(); }
    match /settings/admins { 
      allow read, write: if hasAdminAccess(); 
    }
    match /settings/{docId} { 
      allow read: if docId != 'admins'; 
      allow write: if hasAdminAccess(); 
    }
    match /coupons/{docId} { allow read: if true; allow write: if hasAdminAccess(); }

    // Notifications: anyone can read (global promos), only admin can write
    match /notifications/{docId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    // Referral codes: anyone can read to validate, any user can create/update
    match /referral_codes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: Admins can do anything. Users can create, and read ONLY their own orders. Delivery boys can read assigned orders.
    match /orders/{docId} {
      allow read: if hasAdminAccess() || 
        (request.auth != null && 
         request.auth.token != null && 
         request.auth.token.email != null && (
           resource.data.get('customerEmail', '') == request.auth.token.email.lower() ||
           (resource.data.get('assignedDeliveryBoy', null) != null && 
            resource.data.assignedDeliveryBoy.get('email', '') == request.auth.token.email.lower())
         ));
      allow create: if request.auth != null && 
        request.auth.token != null && 
        request.auth.token.email != null && 
        request.resource.data.get('customerEmail', '') == request.auth.token.email.lower();
      allow update, delete: if hasAdminAccess() || 
        (request.auth != null && 
         request.auth.token != null && 
         request.auth.token.email != null && (
           // Case 1: Delivery boy updating status
           (isStaffMember() &&
            resource.data.get('assignedDeliveryBoy', null) != null && 
            resource.data.assignedDeliveryBoy.get('email', '') == request.auth.token.email.lower() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'steps', 'assignedDeliveryBoy'])) ||
           
           // Case 2: Customer cancelling their own 'placed' order
           (resource.data.get('customerEmail', '') == request.auth.token.email.lower() && 
            resource.data.get('status', '') == 'placed' && 
            request.resource.data.get('status', '') == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'steps']))
         ));
    }

    // Users: Admins can do anything. Users can read/update their own profile.
    match /users/{userId} {
      allow read: if hasAdminAccess() || isOwner(userId);
      allow create: if isOwner(userId);
      
      // Allow users to update their own profile, but PREVENT them from manually changing sensitive fields
      allow update: if hasAdminAccess() || 
        (isOwner(userId) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'staffPin']) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance']) || 
          (request.resource.data.walletBalance < resource.data.walletBalance && request.resource.data.walletBalance >= 0))
        );
        
        
      allow delete: if hasAdminAccess();
    }

    match /users/{userId}/wallet_transactions/{txId} {
      allow read: if hasAdminAccess() || isOwner(userId);
      allow write: if hasAdminAccess();
    }
  }
}

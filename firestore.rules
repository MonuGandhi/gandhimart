rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function currentUserEmail() {
      return (request.auth != null && request.auth.token != null && 'email' in request.auth.token)
        ? request.auth.token.email.lower()
        : "";
    }

    function isMasterAdmin() {
      return currentUserEmail() in ["monugandhi5911@gmail.com", "monugandhi03@gmail.com"];
    }

    function hasRole(email, roles) {
      return exists(/databases/$(database)/documents/users/$(email)) &&
        get(/databases/$(database)/documents/users/$(email)).data.role in roles;
    }

    function isStaff() {
      return currentUserEmail() != "" &&
        hasRole(currentUserEmail(), ['admin', 'pro_admin']);
    }

    function isStaffMember() {
      return currentUserEmail() != "" &&
        hasRole(currentUserEmail(), ['admin', 'pro_admin', 'delivery_boy']);
    }

    function hasAdminAccess() {
      return isMasterAdmin() || isStaff();
    }

    function isOwner(userId) {
      return currentUserEmail() == userId;
    }

    // Products, Categories, Banners, Settings, Coupons
    match /products/{docId} {
      allow read: if true;
      allow create, delete: if hasAdminAccess();
      allow update: if hasAdminAccess() ||
        // Allow customers to update rating/reviewCount
        (currentUserEmail() != "" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']) &&
         request.resource.data.rating >= 1 &&
         request.resource.data.rating <= 5 &&
         (request.resource.data.reviewCount == resource.data.get('reviewCount', 0) + 1 ||
          request.resource.data.reviewCount == resource.data.get('reviewCount', 0) - 1 ||
          request.resource.data.reviewCount == resource.data.get('reviewCount', 0))) ||
        // Allow customers to update stock and/or inStock (for order placement)
        (currentUserEmail() != "" &&
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inStock']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock'])) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock']) ||
          (request.resource.data.stock < resource.data.get('stock', 0) && request.resource.data.stock >= 0)));
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create: if currentUserEmail() != "" && 
                      request.resource.data.get('userEmail', '').lower() == currentUserEmail() &&
                      request.resource.data.rating is int &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5;
      allow update, delete: if hasAdminAccess() || 
        (currentUserEmail() != "" && 
         resource.data.get('userEmail', '').lower() == currentUserEmail() &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating']) ||
          (request.resource.data.rating is int &&
           request.resource.data.rating >= 1 &&
           request.resource.data.rating <= 5)));
    }
    match /categories/{docId} { allow read: if true; allow write: if hasAdminAccess(); }
    match /banners/{docId} { allow read: if true; allow write: if hasAdminAccess(); }
    match /offers/{docId} { allow read: if true; allow write: if hasAdminAccess(); }
    match /settings/admins { 
      allow read, write: if hasAdminAccess(); 
    }
    match /settings/{docId} { 
      allow read: if docId != 'admins'; 
      allow write: if hasAdminAccess(); 
    }
    match /coupons/{docId} { 
      allow read: if true; 
      allow write: if hasAdminAccess();
      allow update: if hasAdminAccess() || 
        (currentUserEmail() != "" && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
         request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1);
    }

    // Notifications: anyone can read (global promos), only admin can write
    match /notifications/{docId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    // Delivery tracking: admin and pro admin can manage cleanup and monitoring data
    match /delivery_tracking/{docId} {
      allow read, write: if hasAdminAccess();
    }

    // Udhaar entries: only admins can read/write
    match /udhaars/{docId} {
      allow read, write: if hasAdminAccess();
    }

    // Referral codes: anyone can read to validate, any user can create/update
    match /referral_codes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: Admins can do anything. Users can create, and read ONLY their own orders. Delivery boys can read assigned orders.
    match /orders/{docId} {
      allow read: if hasAdminAccess() || 
        (currentUserEmail() != "" && (
           resource.data.get('customerEmail', '') == currentUserEmail() ||
           (resource.data.get('assignedDeliveryBoy', null) != null && 
            resource.data.assignedDeliveryBoy.get('email', '') == currentUserEmail())
         ));
      allow create: if currentUserEmail() != "" && 
        request.resource.data.get('customerEmail', '') == currentUserEmail() &&
        request.resource.data.get('status', '') == 'placed';
      allow update, delete: if hasAdminAccess() || 
        (currentUserEmail() != "" && (
           // Case 1: Delivery boy updating status
           (isStaffMember() &&
            resource.data.get('assignedDeliveryBoy', null) != null && 
            resource.data.assignedDeliveryBoy.get('email', '') == currentUserEmail() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'steps', 'assignedDeliveryBoy'])) ||
           
           // Case 2: Customer cancelling their own 'placed' order
           (resource.data.get('customerEmail', '') == currentUserEmail() && 
            resource.data.get('status', '') == 'placed' && 
            request.resource.data.get('status', '') == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'steps']))
         ));
    }

    // Users: Admins can do anything. Users can read/update their own profile.
    match /users/{userId} {
      allow read: if hasAdminAccess() || isOwner(userId);
      allow create: if currentUserEmail() != "";
      allow update: if hasAdminAccess() || 
        (isOwner(userId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAddresses', 'name', 'phone', 'fcmToken', 'walletBalance', 'referredBy', 'usedCoupons', 'email', 'lastLogin', 'uid', 'referralCode']) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance']) || 
          (request.resource.data.walletBalance <= resource.data.get('walletBalance', 0) && request.resource.data.walletBalance >= 0)));
      allow delete: if hasAdminAccess();
    }

    match /users/{userId}/wallet_transactions/{txId} {
      allow read: if hasAdminAccess() || isOwner(userId);
      allow write: if hasAdminAccess();
    }
  }
}
